From 3a22ffc1792a85b0a8de16d1df41d2714d42f71f Mon Sep 17 00:00:00 2001
From: palazik <gochmyradov0@gmail.com>
Date: Wed, 21 Oct 2026 16:38:26 +0500
Subject: [PATCH] dodge: 4K bootstrap table capacity and 4K user ABI

Both from UniXNU (github.com/UniXNU/UniXNU), which runs iOS and macOS on
non-Apple arm64 and has already done the 4K work we started today -
patches/xnu/native-4k-bootstrap-capacity.patch and native-4k-user-abi.patch.

Bootstrap tables. Dropping ARM_LARGE_MEMORY for 4K also dropped
BOOTSTRAP_TABLE_SIZE from 34 pages to 8, while start.s only ever
invalidated four pages' worth of entries - TTE_PGENTRIES << 2. Our
current layout happens to need exactly four (two roots, two L2s), so it
works, but an L2 page covers 1GB at 4K and any mapping that straddles a
1GB boundary allocates a fifth from memory that was never zeroed. That is
a silent wrong mapping, not a crash. So: 16 pages for non-Apple 4K, the
invalidation loop sized from BOOTSTRAP_TABLE_BYTES rather than a literal
4, and a bounds check in create_bootstrap_mapping that stops dead instead
of writing page tables over whatever follows them.

User ABI. xnu hardcodes 16K in four places that decide what userspace
sees: VM map entry alignment in mach_loader, both commpage page-shift
values, the shared region submap, and PAGE_SHIFT_CONST itself - which
picks 16K whenever memSize > 1GB. We escape that last one today only
because the bring-up arena is 320MB; the first time we hand the kernel
more than a gigabyte it would advertise a page size the kernel is not
built for.

None of this is reachable yet - we are still at boot-progress stage 8 -
but all of it is on the path we are now on, and it is cheaper to take it
while the reason is fresh than to rediscover it from a hang.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 bsd/kern/mach_loader.c        |  5 +++++
 osfmk/arm/arm_init.c          | 15 +++++++++++++++
 osfmk/arm/commpage/commpage.c |  6 ++++++
 osfmk/arm/pmap/pmap.h         |  6 ++++++
 osfmk/arm64/genassym.c        |  1 +
 osfmk/arm64/start.s           | 15 +++++++++++++--
 osfmk/vm/vm_shared_region.c   |  5 +++++
 7 files changed, 51 insertions(+), 2 deletions(-)

diff --git a/bsd/kern/mach_loader.c b/bsd/kern/mach_loader.c
index 1756185..2287fc3 100644
--- a/bsd/kern/mach_loader.c
+++ b/bsd/kern/mach_loader.c
@@ -509,8 +509,13 @@ load_machfile(
 
 #if defined(__arm64__)
 	if (result->is_64bit_addr) {
+/* 4K user ABI from UniXNU (patches/xnu/native-4k-user-abi.patch). */
+#if !defined(APPLE_ARM64_ARCH_FAMILY) && !__ARM_16K_PG__
+		vm_map_set_page_shift(map, FOURK_PAGE_SHIFT);
+#else
 		/* enforce 16KB alignment of VM map entries */
 		vm_map_set_page_shift(map, SIXTEENK_PAGE_SHIFT);
+#endif
 	} else {
 		vm_map_set_page_shift(map, page_shift_user32);
 	}
diff --git a/osfmk/arm/arm_init.c b/osfmk/arm/arm_init.c
index a9ff62a..da6b952 100644
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -396,6 +396,16 @@ arm_init(
 
 
 	{
+		/*
+		 * Native non-Apple 4K builds expose the hardware page size at any
+		 * RAM size. Otherwise this picks 16K whenever memSize > 1GB, which
+		 * would advertise a page size the kernel is not built for - we only
+		 * escape it today because the bring-up arena is 320MB.
+		 * From UniXNU (patches/xnu/native-4k-user-abi.patch).
+		 */
+#if !defined(APPLE_ARM64_ARCH_FAMILY) && !__ARM_16K_PG__
+		PAGE_SHIFT_CONST = ARM_PGSHIFT;
+#else
 		/*
 		 * Select the advertised kernel page size.
 		 */
@@ -413,9 +423,14 @@ arm_init(
 			 */
 			PAGE_SHIFT_CONST = ARM_PGSHIFT;
 		}
+#endif
 
+#if !defined(APPLE_ARM64_ARCH_FAMILY) && !__ARM_16K_PG__
+		page_shift_user32 = ARM_PGSHIFT;
+#else
 		/* 32-bit apps always see 16KB page size */
 		page_shift_user32 = PAGE_MAX_SHIFT;
+#endif
 #ifdef  APPLETYPHOON
 		if (PE_parse_boot_argn("cpus_defeatures", &cpus_defeatures, sizeof(cpus_defeatures))) {
 			if ((cpus_defeatures & 0xF) != 0) {
diff --git a/osfmk/arm/commpage/commpage.c b/osfmk/arm/commpage/commpage.c
index ee9f8de..ce896ab 100644
--- a/osfmk/arm/commpage/commpage.c
+++ b/osfmk/arm/commpage/commpage.c
@@ -175,8 +175,14 @@ commpage_populate(void)
 #if __arm64__
 	*((uint8_t*)(_COMM_PAGE_USER_PAGE_SHIFT_32_LEGACY + _COMM_PAGE_RW_OFFSET)) = (uint8_t) page_shift_user32;
 	*((uint8_t*)(_COMM_PAGE_USER_PAGE_SHIFT_32 + _COMM_PAGE_RO_OFFSET)) = (uint8_t) page_shift_user32;
+/* 4K user ABI from UniXNU (patches/xnu/native-4k-user-abi.patch). */
+#if !defined(APPLE_ARM64_ARCH_FAMILY) && !__ARM_16K_PG__
+	*((uint8_t*)(_COMM_PAGE_USER_PAGE_SHIFT_64_LEGACY + _COMM_PAGE_RW_OFFSET)) = (uint8_t) FOURK_PAGE_SHIFT;
+	*((uint8_t*)(_COMM_PAGE_USER_PAGE_SHIFT_64 + _COMM_PAGE_RO_OFFSET)) = (uint8_t) FOURK_PAGE_SHIFT;
+#else
 	*((uint8_t*)(_COMM_PAGE_USER_PAGE_SHIFT_64_LEGACY + _COMM_PAGE_RW_OFFSET)) = (uint8_t) SIXTEENK_PAGE_SHIFT;
 	*((uint8_t*)(_COMM_PAGE_USER_PAGE_SHIFT_64 + _COMM_PAGE_RO_OFFSET)) = (uint8_t) SIXTEENK_PAGE_SHIFT;
+#endif
 #endif /* __arm64__ */
 
 	commpage_update_timebase();
diff --git a/osfmk/arm/pmap/pmap.h b/osfmk/arm/pmap/pmap.h
index 92691d7..3ab2ded 100644
--- a/osfmk/arm/pmap/pmap.h
+++ b/osfmk/arm/pmap/pmap.h
@@ -111,6 +111,12 @@
  * Upper limit on how many pages can be consumed by bootstrap page tables
  */
 #define BOOTSTRAP_TABLE_SIZE (ARM_PGBYTES * 34)
+#elif !defined(APPLE_ARM64_ARCH_FAMILY) && !__ARM_16K_PG__
+/* Native 4 KiB: two roots plus up to seven L2 pages per 6 GiB mapping.
+ * The physical and virtual bases may each straddle an extra 1 GiB region.
+ * From UniXNU (patches/xnu/native-4k-bootstrap-capacity.patch).
+ */
+#define BOOTSTRAP_TABLE_SIZE (ARM_PGBYTES * 16)
 #else /* defined(ARM_LARGE_MEMORY) */
 #define BOOTSTRAP_TABLE_SIZE (ARM_PGBYTES * 8)
 #endif /* defined(ARM_LARGE_MEMORY) */
diff --git a/osfmk/arm64/genassym.c b/osfmk/arm64/genassym.c
index 19eb823..9597da7 100644
--- a/osfmk/arm64/genassym.c
+++ b/osfmk/arm64/genassym.c
@@ -249,6 +249,7 @@ main(int     argc,
 
 
 	DECLARE("PGBYTES", ARM_PGBYTES);
+	DECLARE("BOOTSTRAP_TABLE_BYTES", BOOTSTRAP_TABLE_SIZE);
 	DECLARE("PGSHIFT", ARM_PGSHIFT);
 
 	DECLARE("VM_MIN_KERNEL_ADDRESS", VM_MIN_KERNEL_ADDRESS);
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 2d4b7e3..916ccbc 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -577,6 +577,10 @@ start_cpu:
 
 	/* allocate an L2 table */
 3:	add	$4, $4, PGBYTES
+	/* Refuse before a new table can overwrite adjacent kernel globals. */
+	add	$6, x25, #(BOOTSTRAP_TABLE_BYTES >> 12), lsl #12
+	cmp	$4, $6
+	b.hs	Lbootstrap_tables_exhausted
 
 	/* create_l1_table_entry(virt_base, L1 table, L2 table, scratch1, scratch2, scratch3) */
 	create_l1_table_entry	$0, $3, $4, $6, $7, $8
@@ -684,8 +688,8 @@ LEXT(start_first_cpu)
 	// Invalidate all entries in the bootstrap page tables
 	mov		x0, #(ARM_TTE_EMPTY)				// Load invalid entry template
 	mov		x1, x25								// Start at V=P pagetable root
-	mov		x2, #(TTE_PGENTRIES)				// Load number of entries per page
-	lsl		x2, x2, #2							// Shift by 2 for num entries on 4 pages
+	mov		x2, #(BOOTSTRAP_TABLE_BYTES / ARM_PGBYTES)
+	lsl		x2, x2, #(ARM_PGSHIFT - TTE_SHIFT)	// Clear the whole reserved pool
 
 Linvalidate_bootstrap:							// do {
 	str		x0, [x1], #(1 << TTE_SHIFT)			//   Invalidate and advance
@@ -769,6 +773,13 @@ Lkernelcache_base_found:
 	lsr		x5,  x24, #(ARM_TT_L2_SHIFT)
 	create_bootstrap_mapping x14, x15, x5, x3, x2, x9, x10, x11, x12, x13
 
+	b		Lbootstrap_tables_ready
+Lbootstrap_tables_exhausted:
+	// MMU is still off. Stop with the offending cursor/end preserved for
+	// the early debugger rather than corrupting memory or forging a map.
+	b		Lbootstrap_tables_exhausted
+Lbootstrap_tables_ready:
+
 #if defined(DODGE)
 	/*
 	 * Splash framebuffer: one Normal-NC L2 block in the EXISTING V=P L2
diff --git a/osfmk/vm/vm_shared_region.c b/osfmk/vm/vm_shared_region.c
index db1d613..7872557 100644
--- a/osfmk/vm/vm_shared_region.c
+++ b/osfmk/vm/vm_shared_region.c
@@ -774,11 +774,16 @@ vm_shared_region_create(
 			sub_map = vm_map_create_options(pmap_nested, 0,
 			    (vm_map_offset_t)size, VM_MAP_CREATE_PAGEABLE);
 
+/* 4K user ABI from UniXNU (patches/xnu/native-4k-user-abi.patch). */
+#if !defined(APPLE_ARM64_ARCH_FAMILY) && !__ARM_16K_PG__
+			vm_map_set_page_shift(sub_map, FOURK_PAGE_SHIFT);
+#else
 			if (is_64bit ||
 			    page_shift_user32 == SIXTEENK_PAGE_SHIFT) {
 				/* enforce 16KB alignment of VM map entries */
 				vm_map_set_page_shift(sub_map, SIXTEENK_PAGE_SHIFT);
 			}
+#endif
 #if __ARM_MIXED_PAGE_SIZE__
 			if (cputype == CPU_TYPE_ARM64 &&
 			    target_page_shift == FOURK_PAGE_SHIFT) {
